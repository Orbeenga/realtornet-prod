# --- AI ASSIST (Meta model drafts; human edits and submits) ---
# Provider base URL + model ID (confirmed). API key comes from the dashboard.
META_MODEL_BASE_URL=https://api.meta.ai/v1
META_MODEL_ID=muse-spark-1.3
META_MODEL_API_KEY=
# Demo flag gating GET /api/v1/ai-assist/logs (admin + flag only).
AI_ASSIST_DEMO_ENABLED=false
# Provider guardrails.
AI_ASSIST_TIMEOUT_SECONDS=15
AI_ASSIST_MAX_TOKENS=300
# Per-user rate limit (requests per window).
AI_ASSIST_RATE_LIMIT_MAX=10
AI_ASSIST_RATE_LIMIT_WINDOW_SECONDS=60
